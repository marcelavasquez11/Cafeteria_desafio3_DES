<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="factura_cafeteria_report">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.basic_layout">
                <t t-call="modulo_cafeteria.factura_cafeteria_document"
                   t-lang="o.partner_id.lang or 'en_US'"/>
            </t>
        </t>
    </template>

    <template id="factura_cafeteria_document">
        <!-- Datos simulados del DTE (códigos, emisor, QR) y venta de origen -->
        <t t-set="dte" t-value="o._dte_datos()"/>
        <t t-set="emisor" t-value="dte['emisor']"/>
        <t t-set="venta" t-value="o.invoice_line_ids.sale_line_ids.order_id[:1]"/>
        <t t-set="lineas" t-value="o.invoice_line_ids.filtered(lambda line: line.display_type == 'product')"/>
        <style type="text/css">
            .cafeteria-invoice { color: #24332d; font-family: "DejaVu Sans", sans-serif; font-size: 9px; }
            .cafeteria-invoice table { border-collapse: collapse; width: 100%; }
            .cafeteria-invoice .muted { color: #69766f; }
            .cafeteria-invoice .version { color: #69766f; font-size: 8px; text-align: right; }
            .cafeteria-invoice .dte-title { color: #176b52; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-align: center; }
            .cafeteria-invoice .dte-name { color: #176b52; font-size: 20px; font-weight: 700; margin-bottom: 8px; text-align: center; }
            .cafeteria-invoice .codes-table { border-bottom: 2px solid #176b52; border-top: 2px solid #176b52; margin-bottom: 10px; }
            .cafeteria-invoice .codes-table td { padding: 6px 4px; vertical-align: middle; }
            .cafeteria-invoice .codes-table .qr { width: 15%; }
            .cafeteria-invoice .codes-table .qr img { height: 78px; width: 78px; }
            .cafeteria-invoice .codes-table .label { color: #176b52; font-weight: 700; }
            .cafeteria-invoice .section-title { background: #e8efeb; border-left: 3px solid #176b52; font-size: 9px; font-weight: 700; margin: 8px 0 4px; padding: 4px 7px; text-align: center; }
            .cafeteria-invoice .parties-table td { border: 1px solid #dce3de; padding: 6px 8px; vertical-align: top; width: 50%; }
            .cafeteria-invoice .parties-table .party-title { color: #176b52; font-size: 9px; font-weight: 700; margin-bottom: 4px; text-align: center; }
            .cafeteria-invoice .parties-table .row { padding: 1px 0; }
            .cafeteria-invoice .box-table td { border: 1px solid #dce3de; padding: 5px 8px; vertical-align: top; }
            .cafeteria-invoice .box-table .head { background: #e8efeb; font-weight: 700; text-align: center; }
            .cafeteria-invoice .lines-table { font-size: 8px; margin-top: 8px; }
            .cafeteria-invoice .lines-table thead { display: table-header-group; }
            .cafeteria-invoice .lines-table th { background: #176b52; color: #fff; padding: 5px 3px; text-align: center; }
            .cafeteria-invoice .lines-table td { border-bottom: 1px solid #dce3de; padding: 5px 3px; vertical-align: top; }
            .cafeteria-invoice .lines-table tr { page-break-inside: avoid; break-inside: avoid; }
            .cafeteria-invoice .number { text-align: right !important; white-space: nowrap; }
            .cafeteria-invoice .totals-table { margin-top: 2px; page-break-inside: avoid; break-inside: avoid; }
            .cafeteria-invoice .totals-table td { padding: 3px 3px; text-align: right; }
            .cafeteria-invoice .totals-table .label { font-weight: 700; text-align: right; }
            .cafeteria-invoice .totals-table .grand-total td { border-top: 2px solid #176b52; color: #176b52; font-size: 12px; font-weight: 700; padding-top: 6px; }
            .cafeteria-invoice .footer-table { margin-top: 10px; }
            .cafeteria-invoice .footer-table td { border: 1px solid #dce3de; padding: 5px 8px; vertical-align: top; }
            .cafeteria-invoice .footer-table .label { color: #176b52; font-weight: 700; width: 22%; }
            .cafeteria-invoice .legal-footer { border-top: 1px solid #dce3de; color: #69766f; font-size: 8px; margin-top: 14px; padding-top: 4px; text-align: center; page-break-inside: avoid; }
        </style>

        <div class="page cafeteria-invoice">
            <div class="version">Ver.1</div>
            <div class="dte-title">DOCUMENTO TRIBUTARIO ELECTRÓNICO</div>
            <div class="dte-name">FACTURA</div>

            <!-- Códigos del DTE (simulados) y QR -->
            <table class="codes-table">
                <tr>
                    <td class="qr"><img t-att-src="'data:image/png;base64,' + dte['qr']"/></td>
                    <td style="width: 52%;">
                        <div><span class="label">Código de Generación:</span> <span t-esc="dte['codigo_generacion']"/></div>
                        <div><span class="label">Número de Control:</span> <span t-esc="dte['numero_control']"/></div>
                        <div><span class="label">Sello de Recepción:</span> <span t-esc="dte['sello_recepcion']"/></div>
                    </td>
                    <td style="width: 33%;">
                        <div><span class="label">Modelo de Facturación:</span> Previo</div>
                        <div><span class="label">Tipo de Transmisión:</span> Normal</div>
                        <div><span class="label">Fecha y Hora de Generación:</span> <span t-esc="dte['fecha_hora']"/></div>
                    </td>
                </tr>
            </table>

            <!-- Emisor y receptor -->
            <table class="parties-table">
                <tr>
                    <td>
                        <div class="party-title">EMISOR</div>
                        <div class="row"><strong>Nombre o razón social:</strong> <span t-esc="emisor['razon_social']"/></div>
                        <div class="row"><strong>NIT:</strong> <span t-esc="emisor['nit']"/></div>
                        <div class="row"><strong>NRC:</strong> <span t-esc="emisor['nrc']"/></div>
                        <div class="row"><strong>Actividad económica:</strong> <span t-esc="emisor['actividad']"/></div>
                        <div class="row"><strong>Dirección:</strong> <span t-esc="emisor['direccion']"/></div>
                        <div class="row"><strong>Número de teléfono:</strong> <span t-esc="emisor['telefono']"/></div>
                        <div class="row"><strong>Correo electrónico:</strong> <span t-esc="emisor['correo']"/></div>
                        <div class="row"><strong>Nombre comercial:</strong> <span t-esc="emisor['nombre_comercial']"/></div>
                        <div class="row"><strong>Tipo de establecimiento:</strong> <span t-esc="emisor['tipo_establecimiento']"/></div>
                    </td>
                    <td>
                        <div class="party-title">RECEPTOR</div>
                        <div class="row"><strong>Nombre o razón social:</strong> <span t-esc="o.partner_id.name"/></div>
                        <div class="row"><strong>DUI:</strong> <span t-esc="o.partner_id.dui or '-'"/></div>
                        <div class="row"><strong>NIT:</strong> <span t-esc="o.partner_id.vat or '-'"/></div>
                        <div class="row"><strong>Dirección:</strong> <span t-esc="o.partner_id.street or '-'"/></div>
                        <div class="row"><strong>Número de teléfono:</strong> <span t-esc="o.partner_id.phone or '-'"/></div>
                        <div class="row"><strong>Correo electrónico:</strong> <span t-esc="o.partner_id.email or '-'"/></div>
                    </td>
                </tr>
            </table>

            <!-- Venta a cuenta de terceros -->
            <div class="section-title">VENTA A CUENTA DE TERCEROS</div>
            <table class="box-table">
                <tr>
                    <td style="width: 50%;"><strong>NIT:</strong> -</td>
                    <td style="width: 50%;"><strong>Nombre, denominación o razón social:</strong> -</td>
                </tr>
            </table>

            <!-- Documentos relacionados (la venta que originó la factura) -->
            <div class="section-title">DOCUMENTOS RELACIONADOS</div>
            <table class="box-table">
                <tr>
                    <td class="head" style="width: 34%;">Tipo de Documento</td>
                    <td class="head" style="width: 33%;">N° de Documento</td>
                    <td class="head" style="width: 33%;">Fecha de Documento</td>
                </tr>
                <tr>
                    <td style="text-align: center;"><t t-if="venta">Orden de venta</t><t t-else="">-</t></td>
                    <td style="text-align: center;"><t t-esc="o.invoice_origin or '-'"/></td>
                    <td style="text-align: center;">
                        <t t-if="venta"><span t-esc="venta.date_order.strftime('%Y-%m-%d')"/></t>
                        <t t-else="">-</t>
                    </td>
                </tr>
            </table>

            <div class="section-title">OTROS DOCUMENTOS ASOCIADOS</div>
            <table class="box-table">
                <tr>
                    <td class="head" style="width: 50%;">Identificación del documento</td>
                    <td class="head" style="width: 50%;">Descripción</td>
                </tr>
                <tr>
                    <td style="text-align: center;">-</td>
                    <td style="text-align: center;">-</td>
                </tr>
            </table>

            <!-- Detalle de productos -->
            <table class="lines-table">
                <thead>
                    <tr>
                        <th style="width: 4%;">N°</th>
                        <th style="width: 7%;">Cantidad</th>
                        <th style="width: 7%;">Unidad</th>
                        <th style="width: 25%;">Descripción</th>
                        <th style="width: 9%;">Precio Unitario</th>
                        <th style="width: 9%;">Otros montos no afectos</th>
                        <th style="width: 9%;">Descuento por ítem</th>
                        <th style="width: 9%;">Ventas No Sujetas</th>
                        <th style="width: 9%;">Ventas Exentas</th>
                        <th style="width: 12%;">Ventas Gravadas</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="lineas" t-as="line">
                        <tr>
                            <td style="text-align: center;" t-esc="line_index + 1"/>
                            <td class="number" t-esc="'%.2f' % line.quantity"/>
                            <td style="text-align: center;">Unidad</td>
                            <td t-esc="line.name"/>
                            <td class="number" t-esc="'%.2f' % line.price_unit"/>
                            <td class="number">0.00</td>
                            <td class="number" t-esc="'%.2f' % max(line.quantity * line.price_unit - line.price_total, 0)"/>
                            <td class="number">0.00</td>
                            <td class="number">0.00</td>
                            <td class="number" t-esc="'%.2f' % line.price_total"/>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- Resumen de la operación -->
            <table class="totals-table">
                <tr>
                    <td class="label" style="width: 55%;">Suma de Ventas:</td>
                    <td style="width: 15%;">0.00</td>
                    <td style="width: 15%;">0.00</td>
                    <td style="width: 15%;" t-esc="'%.2f' % o.amount_total"/>
                </tr>
                <tr><td class="label" colspan="3">Sumatoria de ventas:</td><td t-esc="'%.2f' % o.amount_total"/></tr>
                <tr><td class="label" colspan="3">Monto global Desc., Rebajas y otros a ventas no sujetas:</td><td>0.00</td></tr>
                <tr><td class="label" colspan="3">Monto global Desc., Rebajas y otros a ventas Exentas:</td><td>0.00</td></tr>
                <tr><td class="label" colspan="3">Monto global Desc., Rebajas y otros a ventas gravadas:</td><td>0.00</td></tr>
                <tr><td class="label" colspan="3">Sub-Total:</td><td t-esc="'%.2f' % o.amount_total"/></tr>
                <tr><td class="label" colspan="3">IVA Retenido:</td><td>0.00</td></tr>
                <tr><td class="label" colspan="3">Monto Total de la Operación:</td><td t-esc="'%.2f' % o.amount_total"/></tr>
                <tr><td class="label" colspan="3">Total Otros Montos No Afectos:</td><td>0.00</td></tr>
                <tr class="grand-total">
                    <td class="label" colspan="3">Total a Pagar:</td>
                    <td t-esc="'$ %.2f' % o.amount_total"/>
                </tr>
            </table>

            <!-- Valor en letras, condición y forma de pago (dinámicos) -->
            <table class="footer-table">
                <tr>
                    <td class="label">Valor en Letras:</td>
                    <td t-esc="o._dte_valor_en_letras()"/>
                </tr>
                <tr>
                    <td class="label">Condición de la Operación:</td>
                    <td>
                        <t t-if="o.invoice_payment_term_id"><span t-field="o.invoice_payment_term_id.name"/></t>
                        <t t-elif="o.payment_state in ('paid', 'in_payment')">Contado</t>
                        <t t-else="">Pendiente de pago</t>
                    </td>
                </tr>
                <tr>
                    <td class="label">Forma de pago:</td>
                    <td>
                        <t t-if="venta.metodo_pago == 'tarjeta'">Tarjeta
                            <t t-if="venta.tarjeta_marca">(<span t-field="venta.tarjeta_marca"/><t t-if="venta.tarjeta_ultimos4"> **** <span t-field="venta.tarjeta_ultimos4"/></t>)</t>
                            <t t-if="venta.tarjeta_autorizacion"> · Autorización: <span t-field="venta.tarjeta_autorizacion"/></t>
                        </t>
                        <t t-elif="venta.metodo_pago == 'efectivo'">Efectivo
                            <t t-if="venta.efectivo_recibido"> · Recibido: <span t-field="venta.efectivo_recibido"/> · Vuelto: <span t-field="venta.vuelto"/></t>
                        </t>
                        <t t-elif="o.matched_payment_ids">
                            <t t-foreach="o.matched_payment_ids" t-as="payment"><span t-field="payment.journal_id.name"/></t>
                        </t>
                        <t t-else="">-</t>
                    </td>
                </tr>
                <tr>
                    <td class="label">Observaciones:</td>
                    <td><t t-if="o.narration"><span t-field="o.narration"/></t><t t-else="">-</t></td>
                </tr>
            </table>

            <div class="legal-footer">
                Representación gráfica para fines académicos. Este documento no constituye un DTE fiscal autorizado.
                Códigos, sello y QR simulados.
            </div>
        </div>
    </template>
</odoo>
