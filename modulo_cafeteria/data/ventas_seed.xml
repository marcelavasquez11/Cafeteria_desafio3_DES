<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Ventas de ejemplo (datos ficticios), igual que los productos y clientes de ejemplo.
        Las fechas son relativas a hoy, así el dashboard siempre se ve con datos recientes.
        Cada venta sigue el mismo camino que en la pantalla de Ventas:
          1) se crea (registro + líneas)  2) se confirma  3) se le pone su fecha
          4) según el caso: se paga y se factura, se cancela o queda pendiente.
        Todo está con noupdate="1" y forcecreate="0": solo se carga al instalar en una base nueva.
    -->
    <data noupdate="1">

        <!-- Plan contable: sin diario de ventas no se pueden crear facturas -->
        <function model="account.chart.template" name="try_loading"
                  eval="[[], 'generic_coa', ref('base.main_company')]"/>

        <!-- Stock inicial: 60 unidades de cada producto, para poder vender -->
        <function model="product.template" name="write"
                  eval="[[ref('producto_seed_croissant'), ref('producto_seed_latte'), ref('producto_seed_capuchino'), ref('producto_seed_te_chai'), ref('producto_seed_sandwich'), ref('producto_seed_muffin'), ref('producto_seed_dona'), ref('producto_seed_limonada'), ref('producto_seed_zumo_naranja'), ref('producto_seed_tarta_chocolate')], {'qty_available': 60}]"/>

        <!-- ================= Venta 1: hace 20 días, Universidad (corporativo), efectivo ================= -->
