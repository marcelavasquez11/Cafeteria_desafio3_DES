            <field name="partner_id" ref="cliente_seed_universidad"/>
        </record>
        <record id="venta_seed_01_l1" model="sale.order.line" forcecreate="0">
            <field name="order_id" ref="venta_seed_01"/>
            <field name="product_id" search="[('product_tmpl_id', '=', ref('producto_seed_dona'))]"/>
            <field name="product_uom_qty">12</field>
        </record>
        <record id="venta_seed_01_l2" model="sale.order.line" forcecreate="0">
            <field name="order_id" ref="venta_seed_01"/>
            <field name="product_id" search="[('product_tmpl_id', '=', ref('producto_seed_limonada'))]"/>
            <field name="product_uom_qty">6</field>
        </record>
        <function model="sale.order" name="action_confirm" eval="[[ref('venta_seed_01')]]"/>
        <function model="sale.order" name="write"
                  eval="[[ref('venta_seed_01')], {'date_order': (DateTime.now() - timedelta(days=20)).replace(hour=15, minute=0, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S'), 'metodo_pago': 'efectivo', 'efectivo_recibido': 40}]"/>
        <function model="sale.order" name="action_facturar" eval="[[ref('venta_seed_01')]]"/>

