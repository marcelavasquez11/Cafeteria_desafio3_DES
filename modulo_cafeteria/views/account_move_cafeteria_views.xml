<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_form_cafeteria" model="ir.ui.view">
        <field name="name">account.move.form.cafeteria</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <field name="payment_state"
                       string="Estado de pago"
                       widget="badge"
                       readonly="1"
                       invisible="move_type != 'out_invoice'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">parent.move_type == 'out_invoice'</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='tax_ids']" position="attributes">
                <attribute name="invisible">parent.move_type == 'out_invoice'</attribute>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="replace">
                <field name="amount_untaxed"
                       string="Subtotal"
                       invisible="move_type != 'out_invoice'"
                       readonly="1"
                       colspan="2"/>
                <field name="tax_totals"
                       widget="account-tax-totals-field"
                       nolabel="1"
                       colspan="2"
                       invisible="move_type == 'out_invoice'"
                       readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"/>
                <field name="amount_total"
                       string="Total"
                       class="oe_subtotal_footer_separator"
                       invisible="move_type != 'out_invoice'"
                       readonly="1"
                       colspan="2"/>
            </xpath>
        </field>
    </record>
</odoo>