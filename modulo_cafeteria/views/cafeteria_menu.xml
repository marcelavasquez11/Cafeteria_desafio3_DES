<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Vista Kanban personalizada para los productos -->
    <record id="view_product_template_kanban_cafeteria" model="ir.ui.view">
        <field name="name">product.template.kanban.cafeteria</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">

            <kanban class="o_cafeteria_kanban">
                <field name="name"/>
                <field name="list_price"/>
                <field name="categ_id"/>
                <field name="qty_available"/>
                <field name="image_128"/>
                <field name="estado_stock"/>

                <templates>
                    <t t-name="card">

                        <div class="oe_kanban_global_click"
                             style="width: 100%; box-sizing: border-box; padding: 12px;">

                            <!-- Imagen del producto -->
                            <div style="text-align: center; margin-bottom: 10px;">
                                <field name="image_128"
                                       widget="image"
                                       class="cafeteria_product_image"
                                       options="{'size': [96, 96]}"/>
                            </div>

                            <!-- Nombre -->
                            <div style="margin-bottom: 8px;">
                                <strong style="font-size: 16px;">
                                    <field name="name"/>
                                </strong>
                            </div>

                            <!-- Precio -->
                            <div style="margin-bottom: 3px;">
                                <strong>Precio: </strong>
                                <field name="list_price"
                                       widget="monetary"/>
                            </div>

                            <!-- Categoría -->
                            <div style="margin-bottom: 3px;">
                                <strong>Categoría: </strong>
                                <field name="categ_id"/>
                            </div>

                            <!-- Stock -->
                            <div>
                                <strong>Stock: </strong>
                                <field name="qty_available"/>
                            </div>

                            <!-- Alerta de stock: bajo (amarillo) o agotado (rojo) -->
                            <div t-if="record.estado_stock.raw_value == 'bajo'"
                                 style="margin-top: 6px;">
                                <span style="color: #d4a017; font-weight: 600;">⚠️ Stock bajo</span>
                            </div>
                            <div t-if="record.estado_stock.raw_value == 'agotado'"
                                 style="margin-top: 6px;">
                                <span class="text-danger" style="font-weight: 600;">⛔ Agotado</span>
                            </div>

                        </div>

                    </t>
                </templates>

            </kanban>

        </field>
    </record>


    <!-- Acción principal del módulo -->
    <record id="action_cafeteria" model="ir.actions.act_window">
        <field name="name">Cafetería</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>

        <!-- Usar nuestra vista Kanban -->
        <field name="view_id" ref="view_product_template_kanban_cafeteria"/>
        <field name="search_view_id" ref="view_product_template_search_cafeteria"/>
    </record>

    <record id="action_cafeteria_pos" model="ir.actions.client">
        <field name="name">Cafetería</field>
        <field name="tag">modulo_cafeteria.cafeteria_pos</field>
    </record>


    <!-- Pantalla de inicio (dashboard) -->
    <record id="action_cafeteria_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">modulo_cafeteria.cafeteria_dashboard</field>
    </record>


    <!-- Menú principal -->
    <menuitem
        id="menu_cafeteria_root"
        name="Cafetería"
        sequence="10"
    />


    <!-- Primer submenú: al entrar a Cafetería se abre el dashboard -->
    <menuitem
        id="menu_cafeteria_dashboard"
        name="Dashboard"
        parent="menu_cafeteria_root"
        action="action_cafeteria_dashboard"
        sequence="1"
    />

    <!-- Submenú Productos -->
    <menuitem
        id="menu_cafeteria_productos"
        name="Inventario"
        parent="menu_cafeteria_root"
        action="action_cafeteria"
        sequence="10"
    />

    <menuitem
        id="menu_cafeteria_carrito"
        name="Carrito"
        parent="menu_cafeteria_root"
        action="action_cafeteria_pos"
        sequence="5"
    />

    <menuitem
        id="menu_cafeteria_clientes"
        name="Clientes"
        parent="menu_cafeteria_root"
        action="action_clientes_cafeteria"
        sequence="15"
    />

    <menuitem
        id="menu_cafeteria_ventas"
        name="Ventas"
        parent="menu_cafeteria_root"
        action="sale.action_orders"
        sequence="20"
    />

</odoo>